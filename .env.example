# DeepSeek LLM 配置
DEEPSEEK_API_KEY=你的DeepSeek_API_Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# 智谱 Embedding 配置
ZHIPU_API_KEY=你的智谱AI_API_Key

# CORS 配置（逗号分隔，* 表示允许所有）
CORS_ORIGINS=http://localhost:3000

# RAG 配置（可选，有默认值）
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
# TOP_K=10
# RERANK_TOP_N=5
# ENABLE_RERANK=true
# BM25_WEIGHT=0.3
# ENABLE_BM25=true

# 对话配置（可选）
# MAX_HISTORY_TURNS=10
